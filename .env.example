PLANFIX_BASE_URL=https://your-company.planfix.com/rest
PLANFIX_TOKEN=your_token_here
PLANFIX_TIMEOUT_SEC=20
PLANFIX_RETRY_MAX=2
PLANFIX_MIN_REQUEST_INTERVAL_SEC=1.0
PLANFIX_STATUS_CHANGE_DELAY_SEC=1.0
PLANFIX_SILENT_DEFAULT=false
LOG_LEVEL=INFO
# If you use secure keyring setup (`planfix-mcp-secrets-init`),
# PLANFIX_BASE_URL and PLANFIX_TOKEN can be omitted from env.
# Optional preflight extra check:
# PLANFIX_PREFLIGHT_TASK_LIST=1
